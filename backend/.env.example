PORT=5000
# Local dev: mongodb://localhost:27017/assetflow
# Production (Render): use a MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/assetflow
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# One or more comma-separated origins allowed to call this API.
# Local dev: http://localhost:5173
# Production: your Vercel URL(s), e.g. https://assetflow.vercel.app,https://assetflow-git-main-yourname.vercel.app
CLIENT_ORIGIN=http://localhost:5173
